# Secrets: the API key lives in .env.local, never in git.
.env
.env.*
!.env.example

# Runtime data: uploaded photos, voice, generated images, the sample shop.
data/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.claude/
*.log

# Studio step log (preview): regenerated on every run.
studio/log.jsonl

# sim: separate venv for AgentScope; per-run caches and listing photos (events and summaries are kept)
.venv-sim/
runs/*/listing-runs/
runs/*/cache/
runs/*/audit*
