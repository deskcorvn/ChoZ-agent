# Meta Model API key from dev.meta.ai. Without it the app runs in mock mode (clearly labelled).
MODEL_API_KEY=

# auto (default): live when MODEL_API_KEY is set, otherwise mock. Use live or mock to force one.
LISTING_MODE=auto

# Optional overrides.
# LISTING_TEXT_MODEL=muse-spark-1.3
# LISTING_IMAGE_MODEL=muse-image-1.0
# LISTING_SAM_MODEL=sam-3.1
# LISTING_ASR_MODEL=muse-voice-transcribe-1.0
# LISTING_LANGUAGE_BIAS=Vietnamese
# LISTING_DATA_DIR=data
